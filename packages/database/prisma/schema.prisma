generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedCampaigns Campaign[]       @relation("CampaignOwner")
  memberships    CampaignMember[]
  invites CampaignInvite[]
  characters Character[]
  createdSheetTemplates CharacterSheetTemplate[]

  @@map("users")
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User             @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    CampaignMember[]
  invites    CampaignInvite[]
  sessions   Session[]
  characters Character[]
  sheetTemplates CharacterSheetTemplate[]

  @@index([ownerId])
  @@map("campaigns")
}

model CampaignMember {
  id         String       @id @default(uuid())
  campaignId String
  userId     String
  role       CampaignRole @default(PLAYER)
  joinedAt   DateTime     @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_members")
}

enum CampaignRole {
  GM
  PLAYER
}

model CampaignInvite {
  id         String       @id @default(uuid())
  campaignId String
  userId     String
  status     InviteStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_invites")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Session {
  id          String        @id @default(uuid())
  name        String
  description String?
  scheduledAt DateTime?
  status      SessionStatus @default(PLANNED)
  campaignId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("sessions")
}

enum SessionStatus {
  PLANNED
  ACTIVE
  FINISHED
}

model Character {
  id          String   @id @default(uuid())
  name        String
  description String?
  avatarUrl   String?
  sheetData   Json?
  campaignId  String
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sheet CharacterSheet?

  @@index([campaignId])
  @@index([ownerId])
  @@map("characters")
}

model CharacterSheetTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  definition  Json
  campaignId  String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign  Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  sheets    CharacterSheet[]

  @@index([campaignId])
  @@index([createdById])
  @@map("character_sheet_templates")
}

model CharacterSheet {
  id          String   @id @default(uuid())
  characterId String   @unique
  templateId  String
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  character Character              @relation(fields: [characterId], references: [id], onDelete: Cascade)
  template  CharacterSheetTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([templateId])
  @@map("character_sheets")
}